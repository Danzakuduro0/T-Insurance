# Скопируйте в .env (он не попадает в git) и задайте свои значения.
# docker compose читает .env автоматически; серверу передайте те же значения переменными окружения.

# Пароль PostgreSQL (docker compose) — его же укажите серверу в DB_PASSWORD
POSTGRES_PASSWORD=
DB_PASSWORD=

# Обязателен для запуска в режиме prod: случайная строка не короче 32 символов
# (например: openssl rand -base64 48)
JWT_SECRET=

# dev — локальная разработка, prod — показ. Без значения: из IntelliJ/gradle — dev, собранный jar — prod,
# сервер в docker compose — dev
APP_MODE=

# Часовой пояс для фильтров очереди «с даты по дату», если веб оператора не передал свой (по умолчанию Europe/Moscow)
APP_TIME_ZONE=

# Демо-данные в prod: DEMO_SEED=true и пароль демо-учёток не короче 10 символов
DEMO_SEED=
DEMO_PASSWORD=

# Каталог файлов обращений (по умолчанию ~/.tstrah/files; в контейнере — том files)
STORAGE_DIR=
